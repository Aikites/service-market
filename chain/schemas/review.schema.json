{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-site.invalid/chain/schemas/review.schema.json",
  "title": "reports/{task}/attempt-{nn}/review.json",
  "description": "DeepSeek 评审报告（机器可读）。loop 只认本文件；review.md 由本文件生成，不参与判定。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "task_id",
    "attempt_id",
    "base_commit",
    "commit",
    "diff_hash",
    "truncated",
    "reviewer",
    "verdict",
    "findings",
    "test_gaps",
    "confidence",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "review_id": { "type": "string", "minLength": 8, "maxLength": 120 },
    "task_id": { "type": "string", "pattern": "^T-[0-9]{3}$" },
    "attempt_id": { "type": "string", "pattern": "^T-[0-9]{3}-A[0-9]{2}$" },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "diff_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "truncated": {
      "type": "boolean",
      "description": "true 表示 diff 被裁剪；此时 verdict 不得为 approve。"
    },
    "reviewer": { "$ref": "#/$defs/modelRef" },
    "verdict": {
      "type": "string",
      "enum": ["approve", "block", "needs_human"]
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "test_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/testGap" }
    },
    "invariant_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/invariantCoverage" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string", "maxLength": 2000 },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "$defs": {
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_hash"],
      "properties": {
        "provider": { "type": "string", "enum": ["deepseek"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model_version": { "type": ["string", "null"], "maxLength": 40 },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "line",
        "hunk",
        "severity",
        "category",
        "issue",
        "must_fix"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^F[0-9]{1,3}$" },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\).+$"
        },
        "line": { "type": "integer", "minimum": 1 },
        "hunk": {
          "type": "string",
          "pattern": "^@@ -[0-9]+(,[0-9]+)? \\+[0-9]+(,[0-9]+)? @@"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "category": {
          "type": "string",
          "enum": [
            "correctness",
            "design",
            "security",
            "scope",
            "idempotency",
            "amount",
            "state_machine",
            "permissions",
            "tests",
            "i18n",
            "performance",
            "other"
          ]
        },
        "invariant_id": {
          "type": ["string", "null"],
          "pattern": "^INV-[0-9]{3}$"
        },
        "issue": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": { "type": ["string", "null"], "maxLength": 1000 },
        "suggestion": { "type": ["string", "null"], "maxLength": 1000 },
        "must_fix": { "type": "boolean" }
      }
    },
    "testGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "severity"],
      "properties": {
        "behavior": { "type": "string", "minLength": 1, "maxLength": 500 },
        "suggested_test": { "type": ["string", "null"], "maxLength": 200 },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        }
      }
    },
    "invariantCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "covered"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-[0-9]{3}$" },
        "covered": { "type": "boolean" },
        "test_ids": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "uniqueItems": true
        }
      }
    }
  }
}

