{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-site.invalid/chain/schemas/run.schema.json",
  "title": "chain/runs.jsonl 单行成本记录",
  "description": "每次模型调用一行，只追加不修改。成本的事实源；state.json 中的聚合同为派生缓存。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "trace_id",
    "ts_start",
    "ts_end",
    "task_id",
    "attempt_id",
    "round",
    "phase",
    "purpose",
    "provider",
    "model",
    "prompt_hash",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "total_tokens",
    "usage_source",
    "pricing_version",
    "currency",
    "cost_cny",
    "latency_ms",
    "retry_count",
    "status",
    "cache_hit",
    "context_truncated",
    "redaction_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 8, "maxLength": 120 },
    "trace_id": {
      "type": "string",
      "pattern": "^tr-[A-Za-z0-9._-]{8,64}$"
    },
    "ts_start": { "$ref": "#/$defs/timestamp" },
    "ts_end": { "$ref": "#/$defs/timestamp" },
    "task_id": { "type": "string", "pattern": "^T-[0-9]{3}$" },
    "attempt_id": {
      "anyOf": [
        { "type": "string", "pattern": "^T-[0-9]{3}-A[0-9]{2}$" },
        { "type": "null" }
      ]
    },
    "round": { "type": "integer", "minimum": 1, "maximum": 2 },
    "phase": { "$ref": "#/$defs/phase" },
    "purpose": { "$ref": "#/$defs/purpose" },
    "provider": {
      "type": "string",
      "enum": ["deepseek"],
      "description": "竞标工厂锁定单一 provider。"
    },
    "model": { "type": "string", "minLength": 1, "maxLength": 80 },
    "model_version": { "type": ["string", "null"], "maxLength": 40 },
    "request_id": { "type": ["string", "null"], "maxLength": 120 },
    "prompt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "cached_input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "usage_source": {
      "type": "string",
      "enum": ["provider", "estimated", "mixed"],
      "description": "provider 返回的 usage 才算精确成本；estimated 不得混入精确报表。"
    },
    "pricing_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-cny-[0-9]{2}$"
    },
    "currency": { "const": "CNY" },
    "input_cache_hit_per_1m": { "type": "number", "minimum": 0 },
    "input_cache_miss_per_1m": { "type": "number", "minimum": 0 },
    "output_per_1m": { "type": "number", "minimum": 0 },
    "cost_cny": { "type": "number", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
    "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
    "status": {
      "type": "string",
      "enum": ["ok", "error", "timeout", "cancelled"]
    },
    "error_code": { "type": ["string", "null"], "maxLength": 80 },
    "cache_hit": {
      "type": "boolean",
      "description": "本地响应复用时为 true，此时 cost_cny 必须为 0。"
    },
    "context_truncated": { "type": "boolean" },
    "dropped_context": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "uniqueItems": true
    },
    "redaction_version": { "type": "string", "maxLength": 16 }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "phase": {
      "type": "string",
      "enum": ["plan", "build", "i18n", "verify", "rca", "review", "summary"]
    },
    "purpose": {
      "type": "string",
      "enum": ["planner", "builder", "i18n", "rca", "reviewer"]
    }
  }
}

