{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-site.invalid/chain/schemas/state.schema.json",
  "title": "chain/state.json",
  "description": "控制层快照。事实源为 chain/events.jsonl；本文件只由持锁的 loop 进程原子写入，禁止手工编辑，禁止 Builder 写入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "updated_at",
    "last_event_seq",
    "last_event_hash",
    "current_task_id",
    "global",
    "tasks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1, "maxLength": 64 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "last_event_seq": { "type": "integer", "minimum": 0 },
    "last_event_hash": { "$ref": "#/$defs/sha256OrNull" },
    "current_task_id": { "$ref": "#/$defs/taskIdOrNull" },
    "global": { "$ref": "#/$defs/global" },
    "tasks": {
      "type": "object",
      "propertyNames": { "pattern": "^T-[0-9]{3}$" },
      "additionalProperties": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "ISO-8601 UTC，毫秒精度。"
    },
    "timestampOrNull": {
      "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256OrNull": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "gitShaOrNull": {
      "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }]
    },
    "taskId": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "taskIdOrNull": {
      "anyOf": [{ "$ref": "#/$defs/taskId" }, { "type": "null" }]
    },
    "attemptId": {
      "type": "string",
      "pattern": "^T-[0-9]{3}-A[0-9]{2}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\).+$",
      "description": "仓库根相对路径，使用 /，不以 / 开头，不含反斜杠。"
    },
    "repoPathOrNull": {
      "anyOf": [{ "$ref": "#/$defs/repoPath" }, { "type": "null" }]
    },
    "money": {
      "type": "number",
      "minimum": 0,
      "description": "CNY，保留 6 位小数。"
    },
    "taskStatus": {
      "type": "string",
      "enum": [
        "pending_confirm",
        "confirmed",
        "building",
        "built",
        "verifying",
        "rca",
        "fixing",
        "reviewing",
        "review_fix",
        "awaiting_merge",
        "merged",
        "waiting_human",
        "rejected",
        "failed",
        "aborted",
        "budget_exceeded"
      ]
    },
    "attemptStatus": {
      "type": "string",
      "enum": [
        "created",
        "building",
        "built",
        "verifying",
        "rca",
        "fixing",
        "reviewing",
        "passed",
        "failed",
        "blocked",
        "incomplete",
        "abandoned"
      ]
    },
    "failureClass": {
      "type": "string",
      "enum": [
        "INFRA_NETWORK",
        "INFRA_DISK",
        "ENV_MISMATCH",
        "COMPILE_ERROR",
        "TYPE_ERROR",
        "LINT_ERROR",
        "TEST_ASSERT",
        "TEST_FLAKE",
        "INVARIANT_FAIL",
        "I18N_PARITY",
        "BUILD_ERROR",
        "SCOPE_VIOLATION",
        "PROTECTED_PATH",
        "TEST_TAMPERING",
        "SECURITY",
        "MODEL_OUTPUT_INVALID",
        "MODEL_API_ERROR",
        "REVIEW_BLOCK",
        "NO_PROGRESS",
        "BUDGET_EXCEEDED"
      ]
    },
    "failureClassOrNull": {
      "anyOf": [{ "$ref": "#/$defs/failureClass" }, { "type": "null" }]
    },
    "blockedReason": {
      "type": "string",
      "enum": [
        "no_diff",
        "scope_violation",
        "protected_path",
        "test_tampering",
        "invariant_uncovered",
        "invariant_fail",
        "rca_low_confidence",
        "no_reproduction",
        "no_progress",
        "review_exhausted",
        "budget_exceeded",
        "state_drift",
        "infra_error",
        "security",
        "approval_missing",
        "approval_invalidated",
        "ci_mismatch",
        "dependency_unmet",
        "model_output_invalid"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["plan", "build", "i18n", "verify", "rca", "review", "summary"]
    },
    "purpose": {
      "type": "string",
      "enum": ["planner", "builder", "i18n", "rca", "reviewer"]
    },
    "provider": {
      "type": "string",
      "enum": ["deepseek"],
      "description": "竞标工厂锁定单一 provider；新增 provider 需人工改 policy 与本 schema。"
    },
    "verifyStatus": {
      "type": "string",
      "enum": ["not_started", "running", "passed", "failed", "error"]
    },
    "reviewVerdict": {
      "type": "string",
      "enum": ["approve", "block", "needs_human"]
    },
    "reviewVerdictOrNull": {
      "anyOf": [{ "$ref": "#/$defs/reviewVerdict" }, { "type": "null" }]
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "last_reconcile_at"],
      "properties": {
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "currency",
            "daily_max_cny",
            "daily_spent_cny",
            "tasks_started_today"
          ],
          "properties": {
            "date": { "$ref": "#/$defs/date" },
            "currency": { "const": "CNY" },
            "daily_max_cny": {
              "type": "number",
              "minimum": 0,
              "maximum": 8,
              "description": "已确认硬上限 8 元；调整需人工改 policy.json 与本 schema。"
            },
            "daily_spent_cny": { "$ref": "#/$defs/money" },
            "tasks_started_today": { "type": "integer", "minimum": 0 }
          }
        },
        "last_reconcile_at": { "$ref": "#/$defs/timestampOrNull" }
      }
    },
    "taskBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost_cny",
        "max_model_calls",
        "max_input_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "max_cost_cny": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8,
          "description": "单任务上限 8 元。"
        },
        "max_model_calls": { "type": "integer", "minimum": 1, "maximum": 50 },
        "max_input_tokens": { "type": "integer", "minimum": 1000 },
        "max_output_tokens": { "type": "integer", "minimum": 1000 }
      }
    },
    "taskCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "cost_cny",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "model_calls",
        "ci_runs",
        "budget",
        "budget_status"
      ],
      "properties": {
        "currency": { "const": "CNY" },
        "cost_cny": { "$ref": "#/$defs/money" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 },
        "ci_runs": { "type": "integer", "minimum": 0 },
        "by_phase": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": { "$ref": "#/$defs/money" },
            "build": { "$ref": "#/$defs/money" },
            "i18n": { "$ref": "#/$defs/money" },
            "rca": { "$ref": "#/$defs/money" },
            "review": { "$ref": "#/$defs/money" }
          }
        },
        "budget": { "$ref": "#/$defs/taskBudget" },
        "budget_status": {
          "type": "string",
          "enum": ["within", "warning", "exceeded"]
        },
        "last_updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "attemptCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "cost_cny",
        "input_tokens",
        "output_tokens",
        "model_calls"
      ],
      "properties": {
        "currency": { "const": "CNY" },
        "cost_cny": { "$ref": "#/$defs/money" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "model_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "builderRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "provider",
        "model",
        "prompt_hash",
        "changed",
        "created_at"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model_version": { "type": ["string", "null"], "maxLength": 40 },
        "prompt_hash": { "$ref": "#/$defs/sha256" },
        "changed": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report"],
      "properties": {
        "status": { "$ref": "#/$defs/verifyStatus" },
        "failure_class": { "$ref": "#/$defs/failureClassOrNull" },
        "report": { "$ref": "#/$defs/repoPathOrNull" },
        "failed_tests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true
        },
        "required_tests_status": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["pending", "passed", "failed", "missing"]
          }
        },
        "invariant_status": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["covered", "uncovered", "failed"]
          }
        },
        "local_exit_code": { "type": ["integer", "null"] },
        "ci_run_id": { "type": ["string", "null"], "maxLength": 64 },
        "ci_commit": { "$ref": "#/$defs/gitShaOrNull" },
        "ci_conclusion": {
          "type": ["string", "null"],
          "enum": ["success", "failure", "cancelled", "skipped", "pending", null]
        }
      }
    },
    "rcaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report", "reproduction_confirmed"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "running", "done", "failed"]
        },
        "report": { "$ref": "#/$defs/repoPathOrNull" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reproduction_confirmed": { "type": ["boolean", "null"] },
        "root_cause": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "reviewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report", "verdict", "must_fix", "round"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "running", "done", "error"]
        },
        "report": { "$ref": "#/$defs/repoPathOrNull" },
        "verdict": { "$ref": "#/$defs/reviewVerdictOrNull" },
        "must_fix": { "type": ["integer", "null"], "minimum": 0 },
        "round": { "type": "integer", "minimum": 0, "maximum": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "review_id": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder_rounds",
        "review_rounds",
        "infra_retries",
        "no_progress_streak"
      ],
      "properties": {
        "builder_rounds": { "type": "integer", "minimum": 0, "maximum": 2 },
        "review_rounds": { "type": "integer", "minimum": 0, "maximum": 1 },
        "infra_retries": { "type": "integer", "minimum": 0, "maximum": 2 },
        "no_progress_streak": { "type": "integer", "minimum": 0, "maximum": 2 },
        "last_failure_class": { "$ref": "#/$defs/failureClassOrNull" },
        "last_failure_signature": { "$ref": "#/$defs/sha256OrNull" },
        "last_diff_similarity": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "next_retry_at": { "$ref": "#/$defs/timestampOrNull" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at", "task_sha256"],
      "properties": {
        "by": { "type": ["string", "null"], "maxLength": 80 },
        "at": { "$ref": "#/$defs/timestampOrNull" },
        "task_sha256": { "$ref": "#/$defs/sha256OrNull" },
        "base_commit": { "$ref": "#/$defs/gitShaOrNull" },
        "diff_hash": { "$ref": "#/$defs/sha256OrNull" },
        "scope": {
          "type": ["string", "null"],
          "enum": ["build", "merge", null]
        },
        "expires_at": { "$ref": "#/$defs/timestampOrNull" },
        "note": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "mergeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "blockers"],
      "properties": {
        "ready": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "uniqueItems": true
        },
        "checked_at": { "$ref": "#/$defs/timestampOrNull" }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pr_url", "merged_commit"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_ready", "ready", "pr_open", "merged", "rejected"]
        },
        "pr_url": { "type": ["string", "null"], "maxLength": 300 },
        "merged_commit": { "$ref": "#/$defs/gitShaOrNull" },
        "merged_at": { "$ref": "#/$defs/timestampOrNull" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify_report", "merge_gate"],
      "properties": {
        "verify_report": { "$ref": "#/$defs/repoPathOrNull" },
        "review_report": { "$ref": "#/$defs/repoPathOrNull" },
        "required_tests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["pending", "passed", "failed", "missing"]
          }
        },
        "invariants": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["covered", "uncovered", "failed"]
          }
        },
        "protected_paths_touched": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" },
          "uniqueItems": true
        },
        "diff_hash": { "$ref": "#/$defs/sha256OrNull" },
        "merge_gate": { "$ref": "#/$defs/mergeGate" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "status",
        "started_at",
        "base_commit",
        "branch",
        "worktree",
        "changed_paths",
        "protected_paths_touched",
        "diff_hash",
        "verification",
        "rca",
        "review",
        "retry",
        "cost"
      ],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/attemptId" },
        "status": { "$ref": "#/$defs/attemptStatus" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestampOrNull" },
        "base_commit": { "$ref": "#/$defs/gitSha" },
        "head_commit": { "$ref": "#/$defs/gitShaOrNull" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 120 },
        "worktree": { "$ref": "#/$defs/repoPath" },
        "diff_hash": { "$ref": "#/$defs/sha256OrNull" },
        "changed_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" },
          "uniqueItems": true
        },
        "untracked_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" },
          "uniqueItems": true
        },
        "protected_paths_touched": {
          "type": "array",
          "items": { "$ref": "#/$defs/repoPath" },
          "uniqueItems": true
        },
        "artifacts_dir": { "$ref": "#/$defs/repoPath" },
        "builder": {
          "anyOf": [{ "$ref": "#/$defs/builderRef" }, { "type": "null" }]
        },
        "verification": { "$ref": "#/$defs/verification" },
        "rca": {
          "anyOf": [{ "$ref": "#/$defs/rcaRef" }, { "type": "null" }]
        },
        "review": {
          "anyOf": [{ "$ref": "#/$defs/reviewRef" }, { "type": "null" }]
        },
        "retry": { "$ref": "#/$defs/retry" },
        "cost": { "$ref": "#/$defs/attemptCost" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "task_file",
        "task_sha256",
        "depends_on",
        "current_attempt",
        "attempts",
        "approval",
        "merge",
        "cost",
        "updated_at"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/taskStatus" },
        "phase": { "type": ["string", "null"], "maxLength": 120 },
        "task_file": { "$ref": "#/$defs/repoPath" },
        "task_sha256": { "$ref": "#/$defs/sha256OrNull" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskId" },
          "uniqueItems": true
        },
        "base_commit": { "$ref": "#/$defs/gitShaOrNull" },
        "branch": { "type": ["string", "null"], "maxLength": 120 },
        "worktree": { "$ref": "#/$defs/repoPathOrNull" },
        "current_attempt": { "type": "integer", "minimum": 0, "maximum": 2 },
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/attempt" },
          "maxItems": 2
        },
        "acceptance": {
          "anyOf": [{ "$ref": "#/$defs/acceptance" }, { "type": "null" }]
        },
        "approval": { "$ref": "#/$defs/approval" },
        "merge": { "$ref": "#/$defs/merge" },
        "cost": { "$ref": "#/$defs/taskCost" },
        "blocked_reason": {
          "anyOf": [{ "$ref": "#/$defs/blockedReason" }, { "type": "null" }]
        },
        "next_action": { "type": ["string", "null"], "maxLength": 120 },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}

